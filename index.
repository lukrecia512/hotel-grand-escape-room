root.innerHTML=`<div class="app"><aside><div class="brand">♛ HOTEL GRAND<small>HR ESCAPE ROOM</small></div><div class="small">Tím: <b>${esc(state.team)}</b></div><div class="rooms">${ROOM.map((x,i)=>`<button class="roomnav ${r===i?'active':''} ${!available(i)?'locked':''}" ${!available(i)?'disabled':''} onclick="goRoom(${i})"><b>${i+1}. ${esc(x.title)}</b><small>${roomDone(i)?'✓ Splnené':available(i)?tasks[i].filter((_,j)=>done(i,j)).length+'/6 dôkazov':'🔒 Zamknuté'}</small></button>`).join('')}</div><div class="ref"><b>📖 UČEBNICA</b>${esc(BOOK)}<br><br>Aktuálne: ${esc(R.src)}</div><button class="outline" onclick="openNotes()">🗒️ HR spis</button><button class="outline" onclick="exportWork()">⬇ Exportovať výsledky</button><button class="gold" onclick="openSubmission()">📨 Odovzdať výsledky</button><button class="outline" onclick="resetGame()">↺ Nová hra</button></aside><main><div class="top"><div><strong>${r+1}. ${esc(R.title)}</strong><div><small>${esc(R.sub)} · Učebnica ${esc(R.src)}</small></div></div><div class="timer">⏱ <span class="timerValue">${timefmt(state.seconds)}</span></div></div><div class="scene" style="background-image:url('${ROOM_IMAGE_DATA[r]}')"><div class="sceneTitle"><h1>${esc(R.sub)}</h1><p>${esc(R.intro)}</p></div><div class="legend">🔎 Preskúmajte označené predmety</div>${positions.map(([x,y],i)=>`<button class="hotspot ${done(r,i)?'done':i===current?'current':'locked'}" style="left:${x}%;top:${y}%" aria-label="${esc(labels[r][i])}" title="${esc(labels[r][i])}" onclick="inspectObject(${r},${i})">${done(r,i)?'✓':i>current?'🔒':marks[i]}<span class="hotlabel">${esc(labels[r][i])}</span></button>`).join('')}<div class="sceneStatus"><div class="scenehint"><b>${current===-1?'Všetky dôkazy zozbierané!':'Aktuálna stopa '+(current+1)+'/6:'}</b> ${current===-1?'Odomknite ďalšiu miestnosť.':'Kliknite na označený predmet „'+esc(labels[r][current])+'“. Ostatné stopy sa sprístupnia postupne.'}</div><button class="outline" onclick="openHelp()">? Návod</button></div></div><section class="workspace"><div class="missionhead"><h2>Vyšetrovací spis · miestnosť ${r+1}</h2><span>${d}/6 dôkazov · spolu ${totalDone()}/30</span></div><div class="progress"><div style="width:${d/6*100}%"></div></div><div class="brief"><div class="briefrow"><div class="number">${String(r+1).padStart(2,'0')}</div><div><strong>Čo máte v tejto miestnosti zistiť?</strong><p>${esc(R.intro)}</p></div></div></div><div class="evidenceboard">${tasks[r].map((t,i)=>`<button class="evidencechip ${done(r,i)?'done':i===current?'active':'locked'}" onclick="inspectObject(${r},${i})"><span>${done(r,i)?'✓':i>current?'🔒':'🔎'}</span><span><b>${esc(t.title)}</b><br><small>${done(r,i)?'Preskúmané':i===current?'Dostupné':'Čaká na predchádzajúcu stopu'}</small></span></button>`).join('')}</div>${roomDone(r)?`<div class="win roomDone"><h2>✓ Miestnosť ${r+1} je dokončená</h2><p>Všetkých šesť stôp bolo spracovaných. ${r<4?'Môžete odomknúť ďalšiu miestnosť.':'Záverečná analýza je hotová.'}</p>${r<4?`<button class="gold" onclick="goRoom(${r+1})">Otvoriť dvere do miestnosti ${r+2} →</button>`:`<button class="gold" onclick="openSubmission()">📨 Odovzdať výsledky vyučujúcej</button> <button class="outline" onclick="exportWork()">Stiahnuť záložnú kópiu HR spisu</button>`}</div>`:''}</section><div class="bottom"><div class="small">Odborné témy: Stachová a Stacho (2023) · Modelový hotel GRAND · Automatické ukladanie</div><div><button class="outline" onclick="openNotes()">HR spis</button> <button class="outline" onclick="openHelp()">? Ako hrať</button></div></div></main></div>`}
function inspectObject(r,i){if(done(r,i)){openTask(r,i);return}let first=tasks[r].findIndex((_,j)=>!done(r,j));if(i!==first){modal('Táto stopa je zatiaľ uzamknutá',`<p>Najskôr musíte spracovať predchádzajúci dôkaz. V tejto miestnosti postupujte krok po kroku.</p><p>Aktuálne dostupná úloha: <b>${esc(tasks[r][first].title)}</b>.</p><button class="gold" onclick="closeModal();openTask(${r},${first})">Preskúmať dostupný dôkaz →</button>`);return}openTask(r,i)}
function start(){let name=document.getElementById('team').value.trim();state.team=name||'HR analytici';state.started=true;save();render();initTimer()}function goRoom(r){if(!available(r))return;state.room=r;save();render();window.scrollTo(0,0)}function resetGame(){if(confirm('Naozaj vymazať postup a začať od začiatku?')){localStorage.removeItem('hotelGrand2D_real_v2');location.reload()}}
function modal(title,body){let old=document.querySelector('.modal');if(old)old.remove();let e=document.createElement('div');e.className='modal';e.innerHTML=`<div class="dialog" role="dialog" aria-modal="true"><header><h2>${esc(title)}</h2><button aria-label="Zavrieť" onclick="closeModal()">×</button></header><div class="body">${body}</div></div>`;document.body.appendChild(e)}function closeModal(){document.querySelector('.modal')?.remove();active=null;feedback='';hintShown=false}function openHelp(){modal('Ako hrať',`<p>V každej miestnosti preskúmajte šesť klikateľných predmetov; každý skrýva jednu odbornú úlohu a ďalší sa odomkne až po spracovaní predchádzajúcej stopy. Každá miestnosť predstavuje krok analýzy práce podľa učebnice. Nasledujúca sa odomkne až po dokončení všetkých šiestich úloh.</p><p>Niektoré úlohy vyžadujú priradenie údajov, iné analýzu dokumentov, modelový rozhovor alebo vlastný odborný text. Pri nesprávnej odpovedi získate vysvetlenie a môžete sa opraviť. Textové úlohy sa kontrolujú z hľadiska rozsahu a štruktúry; ich <b>odbornú správnosť následne posúdi vyučujúci</b>.</p><p>Hra obsahuje 30 úloh a 40-minútový orientačný časovač; pri podrobnom vypracovaní môže trvať dlhšie. Po uplynutí času môžete pokračovať. Na konci kliknite na „Odovzdať výsledky“ a pre istotu si stiahnite aj záložnú kópiu.</p>`)}
function openNotes(){modal('HR spis a poznámky',`<p>Sem si môžete zapísať vlastné zistenia. Spis sa priebežne ukladá.</p><label class="field"><span>Vaše poznámky</span><textarea id="notes" rows="12">${esc(state.notes)}</textarea></label><div class="actions"><button class="gold" onclick="saveNotes()">Uložiť poznámky</button><button class="outline" onclick="exportWork()">Exportovať všetky výsledky</button></div>`)}function saveNotes(){state.notes=document.getElementById('notes').value;save();closeModal()}
function openTask(r,i){active={r,i};feedback='';hintShown=false;drawTask()}function drawTask(){let {r,i}=active,t=tasks[r][i],k=key(r,i),old=state.responses[k]||{};let html=`<div class="source">📖 ${esc(BOOK)} · ${esc(t.src)}<br>Úloha vychádza z odbornej časti učebnice; príbeh a hotelové údaje sú modelovým didaktickým príkladom.</div><p>${esc(t.prompt)}</p>`;
if(t.kind==='multi')html+=`<div class="question">${t.opts.map((o,j)=>`<label class="option"><input type="checkbox" data-opt="${j}" ${old.answers?.includes(j)?'checked':''}><span>${esc(o)}</span></label>`).join('')}</div>`;
if(t.kind==='match')html+=t.rows.map((row,j)=>`<label class="field"><span>${j+1}. ${esc(row[0])}</span><select data-row="${j}"><option value="">— Vyberte kategóriu —</option>${t.opts.map(o=>`<option value="${esc(o)}" ${old.answers?.[j]===o?'selected':''}>${esc(o)}</option>`).join('')}</select></label>`).join('');
if(t.kind==='write')html+=t.fields.map((f,j)=>`<label class="field"><span>${esc(f[0])}</span><textarea data-write="${j}" placeholder="">${esc(old.answers?.[j]||'')}</textarea></label>`).join('')+`<p class="small" style="color:#566">Vyžaduje sa aspoň ${t.min} znakov spolu. Automatická kontrola posudzuje rozsah; obsah posúdi vyučujúci.</p>`;
if(t.kind==='evidence')html+=`<div class="print">${esc(t.text)}</div><label class="option"><input type="checkbox" id="readEvidence" ${old.answers?.[0]?'checked':''}> Preštudoval/a som všetky záznamy a viem ich použiť ako dôkazy.</label>`;
if(t.kind==='interview')html+=`<p>Vyberajte otázky. Odpovede vedúceho sa zobrazia a zostanú uložené.</p><div class="inline">${t.dialogue.map((d,j)=>`<button class="pill ${old.answers?.includes(j)?'selected':''}" onclick="ask(${j})">${esc(d[0])}</button>`).join('')}</div><div id="interviewAnswers">${(old.answers||[]).map(j=>`<div class="evidence"><b>${esc(t.dialogue[j][0])}</b><p>${esc(t.dialogue[j][1])}</p></div>`).join('')}</div>`;
html+=`<div id="taskFeedback">${feedback}</div><div id="taskHint">${hintShown?`<div class="help"><b>Pomôcka</b><p>${esc(t.hint)}</p></div>`:''}</div><div class="actions"><button class="gold" onclick="checkTask()">${done(r,i)?'Skontrolovať znova':'Overiť a uložiť úlohu'}</button><button class="outline" onclick="showHint()">💡 Nápoveda</button><button class="outline" onclick="closeModal()">Zavrieť</button></div>`;modal(`Miestnosť ${r+1} · ${i+1}/6 — ${t.title}`,html)}
function ask(j){let {r,i}=active,k=key(r,i),a=state.responses[k]?.answers||[];if(!a.includes(j))a=[...a,j];state.responses[k]={answers:a};save();drawTask()}function showHint(){if(!hintShown){state.hints++;save()}hintShown=true;document.getElementById('taskHint').innerHTML=`<div class="help"><b>Pomôcka</b><p>${esc(tasks[active.r][active.i].hint)}</p></div>`}
function checkTask(){let {r,i}=active,t=tasks[r][i],k=key(r,i),ans,good=false,why='';if(t.kind==='multi'){ans=[...document.querySelectorAll('[data-opt]:checked')].map(e=>Number(e.dataset.opt));good=ans.length===t.correct.length&&t.correct.every(x=>ans.includes(x));why=good?'Správne ste vyhodnotili všetky položky.':`Správne položky: ${t.correct.map(x=>t.opts[x]).join('; ')}.`}
if(t.kind==='match'){ans=[...document.querySelectorAll('[data-row]')].map(e=>e.value);good=ans.every((a,j)=>a===t.rows[j][1]);why=good?'Správne priradené všetky kategórie.':`Skontrolujte: ${t.rows.map((row,j)=>ans[j]===row[1]?'':row[0]+' → '+row[1]).filter(Boolean).join('; ')}.`}
if(t.kind==='write'){ans=[...document.querySelectorAll('[data-write]')].map(e=>e.value.trim());let len=ans.join(' ').length;good=ans.every(x=>x.length>=20)&&len>=t.min;why=good?'Text bol uložený. Vyučujúci posúdi odbornú správnosť a úplnosť vášho riešenia.':'Doplňte vlastné odborné zdôvodnenie do všetkých polí. Aktuálny rozsah: '+len+' / '+t.min+' znakov.'}
if(t.kind==='evidence'){ans=[!!document.getElementById('readEvidence').checked];good=ans[0];why=good?'Pracovný denník máte sprístupnený ako dôkaz pre ďalšie úlohy.':'Preštudujte denník a potvrďte, že ste ho čítali.'}
if(t.kind==='interview'){ans=state.responses[k]?.answers||[];good=ans.length>=4;why=good?'Získali ste odpovede na '+ans.length+' otázok.':'Položte aspoň štyri otázky z osnovy.'}
state.responses[k]={answers:ans};if(good)state.done[k]=true;save();let more=t.explain?' '+t.explain:'';let example=t.example&&good?`<details><summary>Ukážka možného riešenia (porovnajte s vlastným)</summary><p>${esc(t.example)}</p></details>`:'';document.getElementById('taskFeedback').innerHTML=`<div class="feedback ${good?'ok':''}"><b>${good?'✓ Úloha splnená':'↺ Odpoveď treba dopracovať'}</b><p>${esc(why+more)}</p>${example}${good?`<button class="gold" onclick="nextTask()">${i<5?'Pokračovať na ďalšiu úlohu →':'Vrátiť sa do miestnosti →'}</button>`:''}</div>`}
function nextTask(){let {r,i}=active;closeModal();render();if(i<5){modal('Nová stopa odomknutá',`<p>Správne. V miestnosti sa sprístupnil ďalší predmet. Preskúmajte ho a pokračujte v analýze pracovného miesta.</p><p><b>Nasleduje:</b> ${esc(tasks[r][i+1].title)}</p><button class="gold" onclick="closeModal();inspectObject(${r},${i+1})">Preskúmať novú stopu →</button>`)} }
function exportWork(){let lines=[`HOTEL GRAND – HR ESCAPE ROOM`,`Tím: ${state.team}`,`Dátum: ${new Date().toLocaleString('sk-SK')}`,`Dokončené úlohy: ${totalDone()}/30`,`Použité nápovedy: ${state.hints}`,`Zostávajúci čas: ${timefmt(state.seconds)}`,`Zdroj: ${BOOK}`,`Poznámky: ${state.notes}`,'','DOKUMENTÁCIA A ODPOVEDE'];ROOM.forEach((room,r)=>{lines.push('\n### '+(r+1)+'. '+room.title+' ('+room.src+')');tasks[r].forEach((t,i)=>{let a=state.responses[key(r,i)]?.answers;lines.push('\n'+(i+1)+'. '+t.title+' ['+(done(r,i)?'SPLNENÉ':'NEVYRIEŠENÉ')+']');if(!a)return;if(t.kind==='write')t.fields.forEach((f,j)=>lines.push(f[0]+': '+(a[j]||'')));else if(t.kind==='multi')lines.push(a.map(j=>t.opts[j]).join('; '));else if(t.kind==='match')t.rows.forEach((row,j)=>lines.push(row[0]+' → '+(a[j]||'')));else if(t.kind==='interview')a.forEach(j=>lines.push(t.dialogue[j][0]+' → '+t.dialogue[j][1]));else lines.push('Pracovný denník preštudovaný.')} )});let blob=new Blob([lines.join('\n')],{type:'text/plain;charset=utf-8'}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download='Hotel_GRAND_HR_spis_'+(state.team||'tim').replace(/[^\p{L}\p{N}-]/gu,'_')+'.txt';document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),3000)}

// Odovzdávanie výsledkov do Google Sheets cez Apps Script.
const SUBMISSION_URL = 'https://script.google.com/macros/s/AKfycbxumaHxGu7gwL1LgwGy1FBDpL6nABkGacN1PjufO93hNIqlcR-iG84DQPAKBN_Ikhdr/exec';
let sendingSubmission = false;
function openSubmission(){
  const complete=totalDone()===30;
  const last=state.lastSubmission;
  modal('Odovzdanie HR spisu vyučujúcej',
    `<p><b>Tím:</b> ${esc(state.team)}<br><b>Vypracované úlohy:</b> ${totalDone()}/30</p>`+
    (last?`<div class="help">Posledný pokus o odoslanie: ${esc(last)}. Úspešný zápis treba overiť v tabuľke vyučujúcej.</div>`:'')+
    (!complete?'<div class="feedback">Najskôr dokončite všetkých 30 úloh. Rozpracované odpovede sa priebežne ukladajú v tomto prehliadači.</div>':'<p>Po kliknutí sa odošlú odpovede na všetkých 30 úloh, názov tímu a poznámky. Nezadávajte osobné ani citlivé údaje.</p>')+
    `<label class="field"><span>Názov tímu</span><input id="submissionTeam" maxlength="70" value="${esc(state.team)}"></label>`+
    `<div class="actions"><button class="gold" id="submissionButton" ${complete?'':'disabled'} onclick="sendSubmission()">📨 Odovzdať výsledky</button><button class="outline" onclick="exportWork()">⬇ Stiahnuť záložný HR spis</button></div>`+
    `<div id="submissionStatus" role="status" aria-live="polite"></div>`);
}
async function sendSubmission(){
  if(sendingSubmission||totalDone()!==30)return;
  const team=(document.getElementById('submissionTeam')?.value||'').trim();
  const status=document.getElementById('submissionStatus');
  if(!team){status.innerHTML='<div class="feedback">Zadajte názov tímu.</div>';return;}
  state.team=team;save();
  const answers={};
  ROOM.forEach((room,r)=>tasks[r].forEach((task,i)=>{
    const raw=state.responses[key(r,i)]?.answers;
    let response;
    if(task.kind==='write')response=task.fields.map((f,j)=>({otazka:f[0],odpoved:raw?.[j]||''}));
    else if(task.kind==='multi')response=(raw||[]).map(j=>task.opts[j]);
    else if(task.kind==='match')response=task.rows.map((row,j)=>({polozka:row[0],odpoved:raw?.[j]||''}));
    else if(task.kind==='interview')response=(raw||[]).map(j=>({otazka:task.dialogue[j][0],odpoved:task.dialogue[j][1]}));
    else response=raw?.[0]?'Preštudované':'Nevyplnené';
    answers[`${r+1}.${i+1} ${task.title}`]={miestnost:room.title,splnene:!!state.done[key(r,i)],odpoved:response};
  }));
  answers['Poznámky tímu']=state.notes||'';
  answers['Použité nápovedy']=state.hints;
  const button=document.getElementById('submissionButton');
  sendingSubmission=true;button.disabled=true;status.textContent='Odosielam výsledky…';
  try{
    // Apps Script nevracia čitateľnú odpoveď naprieč doménami; no-cors je preto nevyhnutné.
    // Úspešný fetch znamená iba pokus o doručenie, nie potvrdený zápis do tabuľky.
    await fetch(SUBMISSION_URL,{method:'POST',mode:'no-cors',headers:{'Content-Type':'text/plain;charset=utf-8'},body:JSON.stringify({team,answers})});
    state.lastSubmission=new Date().toLocaleString('sk-SK');save();
    status.innerHTML='<div class="feedback ok"><b>Požiadavka na odoslanie bola odoslaná.</b><p>Prehliadač nedokáže potvrdiť zápis do Google tabuľky. Overte ho u vyučujúcej. Pre istotu si stiahnite aj záložný HR spis.</p></div>';
  }catch(err){
    status.innerHTML='<div class="feedback"><b>Odoslanie sa nepodarilo.</b><p>Skontrolujte internetové pripojenie, skúste to znova a stiahnite si záložný HR spis.</p></div>';
  }finally{sendingSubmission=false;button.disabled=false;}
}

render();if(state.started)initTimer();
</script></body></html>
